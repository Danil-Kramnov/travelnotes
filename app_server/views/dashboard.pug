extends layout 
//- Bootstrap components used: navbar, card, list-group, badge, form-row grid (https://getbootstrap.com/docs/4.1/components/navbar/#how-it-works)
block navbar
  nav.navbar.navbar-expand-lg.navbar-dark.bg-dark
    a.navbar-brand(href='/dashboard') TravelNotes
    button.navbar-toggler(type='button', data-toggle='collapse', data-target='#navbarContent', aria-controls='navbarContent', aria-expanded='false', aria-label='Toggle navigation')
      span.navbar-toggler-icon
    #navbarContent.collapse.navbar-collapse.justify-content-end
      span.navbar-text.text-white.mr-3 Hi, Daniel
      a.btn.btn-outline-light.btn-sm(href='/login') Logout

block content
    //- Card visual styling: https://bootsnipp.com/snippets/67z63

    .container.mt-4
    h2.mb-3 My Destinations

    each country in countries
      .card.mb-3
        .card-header
          strong= country.name
        .card-body
          each city in country.cities
            h5.mt-2= city.name
            ul.list-group.mb-3
              each place in city.places
                li.list-group-item.d-flex.flex-column.flex-sm-row.justify-content-between.align-items-start
                  div
                    div
                      strong= place.name
                      small.text-muted= ' · ' + place.category
                    if place.note
                      div.text-muted= place.note
                    else
                      div.text-muted.font-italic no note yet
                  span.badge(class=place.status === 'Visited' ? 'badge-primary' : 'badge-warning')= place.status

    .card.mt-4
      .card-body
        h5.card-title Add a note
        form(action='/notes', method='POST')
          .form-row
            .form-group.col-md-6
              label(for='noteTitle') Title
              input#noteTitle.form-control(type='text', name='title', placeholder='Title')
            .form-group.col-md-6
              label(for='noteRating') Rating (1–5)
              input#noteRating.form-control(type='number', name='rating', min='1', max='5', placeholder='e.g. 4')
          .form-group
            label(for='noteText') Notes
            textarea#noteText.form-control(name='text', rows='3', placeholder='Write your note...')
          button.btn.btn-success(type='submit') Save note