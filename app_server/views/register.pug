extends layout


block content
  //- Register card adapted from: https://bootsnipp.com/snippets/z8l2X

  .container
    .row
      .col-md-5.mx-auto
        .myform
          .logo.mb-3
            .col-md-12.text-center
              h1 Sign up
          form(action='/register', method='POST', name='registration')
            .form-group
              label(for='name') Name
              input#name.form-control(type='text', name='name', placeholder='Enter your name')
            .form-group
              label(for='email') Email address
              input#email.form-control(type='email', name='email', placeholder='Enter email')
            .form-group
              label(for='password') Password
              input#password.form-control(type='password', name='password', placeholder='Enter password')
            .form-group
              label(for='confirmPassword') Confirm password
              input#confirmPassword.form-control(type='password', name='confirmPassword', placeholder='Confirm password')
            .col-md-12.text-center.mb-3
              button.btn.btn-block.mybtn.btn-primary.tx-tfm(type='submit') Register
            .form-group
              p.text-center
                a(href='/login') Already have an account?